
# NetPulse Environment Configuration
# Copy this file to airflow/.env and replace the placeholder passwords.

# PostgreSQL container initialization
POSTGRES_PASSWORD=replace_with_postgres_password

# Application database connection
DB_HOST=postgres
DB_PORT=5432
DB_NAME=netpulse
DB_USER=netpulse
DB_PASSWORD=replace_with_postgres_password

# Grafana administrator
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_password
